# Copy this file to apps/api/.env for local development (and, if you add
# build-time web env vars, apps/web/.env). Never commit a real .env file —
# it's gitignored already. See PROJECT.md section 6.1 and 7.

# --- apps/api ---
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173

# Nebius Token Factory (NVIDIA Nemotron models). Required — this is the
# only LLM provider in this codebase. See PROJECT.md section 6.1/6.8.
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=
MODEL_FAST=            # Nemotron Nano or Super model ID from Token Factory
MODEL_REASONING=       # Nemotron Ultra model ID from Token Factory

# Nutrition lookups. Required — macros are always computed from this data,
# never invented by the LLM.
USDA_API_KEY=

# Location + availability. Optional - leave blank and the app just skips
# availability checking, same as if the user never shared a location.
# ZIP-to-coordinates geocoding and nearby-store lookup use free public
# APIs (Zippopotam, OpenStreetMap Overpass) and need no key.
TAVILY_API_KEY=
KROGER_CLIENT_ID=      # optional, not implemented
KROGER_CLIENT_SECRET=  # optional, not implemented

# Supabase (auth, saved recipes). Required for login/save-recipe; leave
# blank to run in guest-only mode (the main recipe flow still works).
SUPABASE_URL=
SUPABASE_ANON_KEY=                # same public key as VITE_SUPABASE_ANON_KEY below
SUPABASE_SERVICE_ROLE_KEY=        # server only; reserved for a future shared cache table, not used for saved recipes
SUPABASE_JWKS_URL=                # e.g. https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- apps/web (public values only — never put a secret behind VITE_*) ---
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
