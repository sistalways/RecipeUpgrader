{
  "name": "recipeupgrader",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter @recipeupgrader/shared run build && pnpm -r run typecheck",
    "test": "pnpm --filter @recipeupgrader/shared run build && pnpm -r run test",
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @recipeupgrader/api dev",
    "dev:web": "pnpm --filter @recipeupgrader/web dev"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
